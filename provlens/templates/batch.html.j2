<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>ProvenanceLens triage</title>
<style>
:root { --bg:#f6f6f3; --panel:#fff; --ink:#1d2025; --muted:#5f6670; --line:#e1e1dc; --hi:#fef3c7; --gen:#ede9fe; }
@media (prefers-color-scheme: dark) { :root { --bg:#121315; --panel:#1b1d20; --ink:#e7e7e4; --muted:#9aa0a8; --line:#2d3035; --hi:#3a2d10; --gen:#2a2140; } }
body { margin:0; background:var(--bg); color:var(--ink); font:14px/1.5 system-ui,-apple-system,sans-serif; }
main { max-width:1180px; margin:0 auto; padding:24px 16px; } h1 { font-size:21px; }
.wrap { overflow-x:auto; border:1px solid var(--line); border-radius:10px; background:var(--panel); }
table { border-collapse:collapse; width:100%; font-size:13px; } th, td { text-align:left; padding:7px 9px; border-bottom:1px solid var(--line); vertical-align:top; }
th { color:var(--muted); font-size:11.5px; } img { width:72px; border-radius:6px; }
tr.strong td, tr.moderate td { background:var(--hi); } tr.gen td { background:var(--gen); }
.sub { color:var(--muted); font-size:12px; }
</style></head><body><main>
<h1>ProvenanceLens triage — {{ rows|length }} files, highest editing evidence first</h1>
<div class="wrap"><table><thead><tr><th></th><th>File</th><th>Editing</th><th>AI declared</th><th>Provenance</th><th>Headline</th></tr></thead><tbody>
{% for x in rows %}<tr class="{{ x.level }}{{ ' gen' if x.generated else '' }}">
<td>{% if x.thumb %}<img alt="" src="data:image/jpeg;base64,{{ x.thumb }}">{% endif %}</td>
<td><a href="{{ x.report }}">{{ x.name }}</a><div class="sub">{{ x.format }}</div></td>
<td><b>{{ x.level }}</b><div class="sub">score {{ "%.2f"|format(x.score) }}</div></td>
<td>{{ 'yes' if x.generated else '—' }}</td><td>{{ x.c2pa }}</td><td>{{ x.headline }}</td></tr>{% endfor %}
</tbody></table></div>
<p class="sub">Ranking is by the transparent editing-evidence score; open each report to see the signals behind it.</p>
</main></body></html>
